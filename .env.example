QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=apple_pie_story_chunks
QDRANT_SCROLL_BATCH_SIZE=256
QDRANT_UPDATE_BATCH_SIZE=64

# Minimum number of points HDBSCAN needs to form a cluster; also the minimum
# total point count the service will accept (fewer points raises a 400).
# Production wants ~10 for meaningful clusters. A small local dataset (a
# handful of ingested chunks) needs a low value such as 2, or /cluster-labels
# will always fail with "not enough points to cluster".
HDBSCAN_MIN_CLUSTER_SIZE=10
# Controls how conservatively HDBSCAN treats points as noise. Leave blank to
# let hdbscan default it to HDBSCAN_MIN_CLUSTER_SIZE. Lower it (e.g. 1) for
# small local datasets alongside HDBSCAN_MIN_CLUSTER_SIZE.
HDBSCAN_MIN_SAMPLES=

# Bedrock. Credentials come from the Lambda execution role in deployment and the
# ambient AWS profile locally -- no key belongs in this file.
AWS_REGION=us-east-1
BEDROCK_LABELING_MODEL=amazon.nova-pro-v1:0
BEDROCK_LABELING_TEMPERATURE=0.1
BEDROCK_LABELING_MAX_TOKENS=512
# Sent as the chat call's `temperature`. Leave blank to omit the parameter
# entirely instead of sending a value - some newer model families (e.g.
# gpt-5.6) reject temperature outright, even set to their own default (1).

LLM_CLUSTER_SAMPLE_SIZE=8
LLM_SAMPLE_MAX_CHARS=700
